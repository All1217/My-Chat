# 复制为 /data/my-chat/.env（chmod 600），勿提交真实密钥
# 本文件只放占位符；真实值只写在服务器 /data/my-chat/.env（已 gitignore，勿入库）

# 复用宿主机容器 pg 的密码（创建 pg 时的 POSTGRES_PASSWORD）
PGSQL_PASS=change-me
SPRING_DATASOURCE_USERNAME=postgres
# 经 host.docker.internal 访问宿主机 5432 上的 pg；库名用新建的 mychat
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/mychat?currentSchema=public

# 业务密钥（只填在服务器 .env，不要写进本 example）
OPENAI_API_KEY=
EMBEDDING_MODEL_API_KEY=

# MCP：云上默认只常驻 crawler（Compose 服务 crawler），不启 database MCP / Smithery
# Cursor IDE 的 .cursor/mcp.json 只服务开发机，不是生产依赖
APP_MCP_ENABLED=true
APP_MCP_DATABASE_ENABLED=false
APP_MCP_CRAWLER_ENABLED=true
APP_MCP_SMITHERY_ENABLED=false
# 容器网内地址；勿写成 localhost（app 容器内解析不到宿主机 crawler）
MCP_CRAWLER_URL=http://crawler:8103
# 若完全不需要抓正文，可改 APP_MCP_ENABLED=false（搜集仍成功，仅跳过正文）
# crawler 镜像 pip 源（默认阿里云；直连 PyPI 易超时）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.aliyun.com

# 评估员发信（QQ SMTP）。USER 为发件邮箱，PASS 填授权码，不是登录密码。
# 改完需重建 app 容器；留空则发信跳过，正文只进日志。
# PAPER_MAIL_HOST=smtp.qq.com
# PAPER_MAIL_PORT=587
# PAPER_MAIL_USER=
# PAPER_MAIL_PASS=

# 可选
# EXA_API_KEY=
# SMITHERY_API_KEY=
# BOCHA_API_KEY=
# TAVILY_API_KEY=

# 空库 mychat 保持 false
FLYWAY_BASELINE_ON_MIGRATE=false

# 数据与代码路径（一般不用改）
MYCHAT_DATA=/data/my-chat
MYCHAT_REPO=/data/my-chat/repo
MYCHAT_ENV_FILE=/data/my-chat/.env
