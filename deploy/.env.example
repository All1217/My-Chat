# 复制为 /data/my-chat/.env（chmod 600），勿提交真实密钥
# 本文件只放占位符；真实值只写在服务器 /data/my-chat/.env（已 gitignore，勿入库）

# 复用宿主机容器 pg 的密码（创建 pg 时的 POSTGRES_PASSWORD）
PGSQL_PASS=change-me
SPRING_DATASOURCE_USERNAME=postgres
# 经 host.docker.internal 访问宿主机 5432 上的 pg；库名用新建的 mychat
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/mychat?currentSchema=public

# 业务密钥（只填在服务器 .env，不要写进本 example）
OPENAI_API_KEY=
EMBEDDING_MODEL_API_KEY=

# 云上首期关闭 MCP
APP_MCP_ENABLED=false

# 可选
# EXA_API_KEY=
# SMITHERY_API_KEY=
# BOCHA_API_KEY=
# TAVILY_API_KEY=

# 空库 mychat 保持 false
FLYWAY_BASELINE_ON_MIGRATE=false

# 数据与代码路径（一般不用改）
MYCHAT_DATA=/data/my-chat
MYCHAT_REPO=/data/my-chat/repo
MYCHAT_ENV_FILE=/data/my-chat/.env
