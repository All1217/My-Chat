# 多阶段：Node 20 构建前端 → Nginx 托管静态并反代 /rag
# 构建上下文为仓库根目录：docker build -f deploy/Dockerfile.web .

FROM node:20-alpine AS build
WORKDIR /src
# 2C4G 上 vue-tsc+vite 同跑易 OOM；镜像内只打包，类型检查留本机/CI
ENV NODE_OPTIONS=--max-old-space-size=1536
COPY my-chat-vue3/package.json my-chat-vue3/package-lock.json ./
RUN npm ci
COPY my-chat-vue3/ ./
RUN npx vite build

FROM nginx:1.26-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 80
