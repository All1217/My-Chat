# 监听（默认 0.0.0.0:8103，路径 /mcp）
CRAWLER_HOST=0.0.0.0
CRAWLER_PORT=8103

# 可选：逗号分隔允许的 host；空=不限制公网 host（仍拒绝内网）
# CRAWLER_ALLOW_HOSTS=example.com,www.example.com

# 超时秒、正文最大字符、响应体最大字节、限速（次/秒）、批量上限
# CRAWLER_TIMEOUT_SECONDS=15
# CRAWLER_MAX_TEXT_CHARS=50000
# CRAWLER_MAX_BYTES=2097152
# CRAWLER_RATE_PER_SECOND=2
# CRAWLER_BATCH_LIMIT=5
