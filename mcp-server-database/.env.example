# 复制为 .env（已 gitignore），填真实密码；勿提交 .env

# 当前用哪个库由启动脚本决定（start-postgres / start-mysql），不必改本文件里的 DB_TYPE
# DB_TYPE=postgres

# --- PostgreSQL ---
PGSQL_USER=postgres
PGSQL_PASS=change-me
# PGSQL_JDBC_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=public

# --- MySQL（本机 VM Docker 等）---
MYSQL_USER=root
MYSQL_PASS=change-me
# MYSQL_JDBC_URL=jdbc:mysql://192.168.150.102:3306/?useSSL=true&sslMode=PREFERRED&allowPublicKeyRetrieval=true&characterEncoding=utf8

# 可选：覆盖 connection.label
# APP_DATABASE_CONNECTION_LABEL=local
